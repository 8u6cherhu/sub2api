+// normalizeGeminiRequestForAntigravity adapts standard Gemini JSON to v1internal.
+func normalizeGeminiRequestForAntigravity(body []byte) ([]byte, error) {
+	var request map[string]any
+	if err := json.Unmarshal(body, &request); err != nil {
+		return nil, err
+	}
+	modified := false
+	if contents, ok := request["contents"].([]any); ok {
+		for _, raw := range contents {
+			content, ok := raw.(map[string]any)
+			if !ok {
+				continue
+			}
+			role, exists := content["role"]
+			if !exists || role == nil {
+				content["role"] = "user"
+				modified = true
+				continue
+			}
+			if roleString, ok := role.(string); ok && strings.TrimSpace(roleString) == "" {
+				content["role"] = "user"
+				modified = true
+			}
+		}
+	}
+	if tools, ok := request["tools"].([]any); ok {
+		for _, raw := range tools {
+			tool, ok := raw.(map[string]any)
+			if !ok {
+				continue
+			}
+			search, exists := tool["google_search"]
+			if !exists {
+				continue
+			}
+			if _, exists := tool["googleSearch"]; !exists {
+				tool["googleSearch"] = search
+			}
+			delete(tool, "google_search")
+			modified = true
+		}
+	}
+	if !modified {
+		return body, nil
+	}
+	return json.Marshal(request)
+}
